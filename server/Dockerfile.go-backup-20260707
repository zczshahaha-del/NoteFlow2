FROM golang:1.25-alpine AS build

WORKDIR /app

COPY go.mod go.sum* ./
RUN go mod download

COPY . .
RUN go build -o /out/noteflow-server .

FROM alpine:3.20

RUN adduser -D -H appuser

WORKDIR /app
COPY --from=build /out/noteflow-server /app/noteflow-server

USER appuser
EXPOSE 8080

CMD ["/app/noteflow-server"]

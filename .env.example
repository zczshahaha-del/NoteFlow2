# Frontend local development.
# Leave empty when frontend and backend are served by the same Nginx domain.
VITE_API_BASE_URL=

# Docker Compose backend and PostgreSQL settings.
POSTGRES_DB=noteflow
POSTGRES_USER=noteflow
POSTGRES_PASSWORD=replace_with_postgres_password

JWT_SECRET=replace_with_a_long_random_secret
ENVIRONMENT=production
AUTH_COOKIE_SECURE=true
AUTH_ACCESS_TTL_MINUTES=30
AUTH_SESSION_TTL_DAYS=7
LOGIN_RATE_LIMIT_PER_5_MINUTES=12
FRONTEND_BASE_URL=https://notes.example.com
# Optional HTTPS webhook that receives { email, resetUrl, expiresInMinutes }.
PASSWORD_RESET_WEBHOOK_URL=
PASSWORD_RESET_TTL_MINUTES=30

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Set these from the provider's current billing page; zero records usage without claiming a cost.
LLM_INPUT_USD_PER_MILLION_TOKENS=0
LLM_OUTPUT_USD_PER_MILLION_TOKENS=0
EMBEDDING_USD_PER_MILLION_TOKENS=0

AI_RATE_LIMIT_PER_MINUTE=30
EMBEDDING_RATE_LIMIT_PER_MINUTE=60
RERANKER_RATE_LIMIT_PER_MINUTE=60
MEMORY_RATE_LIMIT_PER_MINUTE=60
INDEX_RATE_LIMIT_PER_MINUTE=30
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=3600
AGENT_RUNTIME=legacy
DRAFT_RUNTIME=legacy
EDIT_RUNTIME=legacy
RAG_PROVIDER=legacy
MEMORY_PROVIDER=legacy
RERANKER_PROVIDER=legacy
VECTOR_STORE_PROVIDER=legacy
AGENT_SHADOW_ENABLED=false
LANGGRAPH_POC_ENABLED=false
LANGGRAPH_SHADOW_ENABLED=false
LANGGRAPH_SHADOW_SAMPLE_PERCENT=0
LANGGRAPH_SHADOW_TIMEOUT_MS=2500
LANGGRAPH_SHADOW_MAX_CONCURRENCY=2
# Optional comma-separated authenticated user ids; when set, overrides sampling.
LANGGRAPH_SHADOW_USER_IDS=
RAG_SHADOW_ENABLED=false
MEMORY_SHADOW_ENABLED=false
MEMORY_SHADOW_READ_PERCENT=0
MEMORY_SHADOW_WRITE_ENABLED=false
MEM0_CANARY_ENABLED=false
MEM0_CANARY_PERCENT=0
MEM0_CANARY_USER_IDS=
MEM0_TIMEOUT_MS=1800
MEM0_ERROR_THRESHOLD=5
MEM0_ERROR_WINDOW_SECONDS=60
MEM0_CIRCUIT_COOLDOWN_SECONDS=120
MEMORY_CONTEXT_LIMIT=6
AI_CANARY_PERCENT=0
LANGGRAPH_CANARY_ENABLED=false
LANGGRAPH_CANARY_PERCENT=0
LANGGRAPH_CANARY_USER_IDS=
LANGGRAPH_CANARY_ERROR_THRESHOLD=5
LANGGRAPH_CANARY_WINDOW_SECONDS=60
LANGGRAPH_CANARY_COOLDOWN_SECONDS=120
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_CANDIDATE_K=40
RAG_TOP_K=8
RAG_RRF_K=60
RAG_RERANK_TIMEOUT_SECONDS=3
RAG_BM25_TOKENIZER=jieba_search
RAG_V2_INDEX_ENABLED=false
RAG_REWRITE_ENABLED=true
RAG_BM25_ENABLED=true
RAG_VECTOR_ENABLED=true
RAG_RERANK_ENABLED=false
RAG_CHANNEL_TIMEOUT_MS=1800
RAG_CONTEXT_TOKEN_BUDGET=6000
RAG_QUERY_CACHE_TTL_SECONDS=60
RAG_TITLE_RRF_WEIGHT=1.25
RAG_BM25_RRF_WEIGHT=1.0
RAG_VECTOR_RRF_WEIGHT=1.0
RAG_VECTOR_MIN_SIMILARITY=0.45
RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_MODEL=
RERANKER_BATCH_SIZE=50
MEM0_COLLECTION_NAME=noteflow_mem0_v1
MEM0_HISTORY_DB_PATH=/tmp/noteflow-mem0-history.db
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_SECONDS=2
OUTBOX_STALE_SECONDS=300
OUTBOX_MAX_ATTEMPTS=8
INDEX_JOB_STALE_SECONDS=300
# Set false for an immediate rollback to the legacy SSE encoder.
SSE_ADAPTER_ENABLED=true

    "test:input-composition": "node --experimental-strip-types scripts/input-composition-test.ts",
    "test:backend": "node scripts/run-python.mjs -m unittest discover -s server/tests -p test_*.py",
    "test:architecture": "node scripts/run-python.mjs -m unittest server.tests.test_architecture_contracts -v",
    "test:rag": "node scripts/run-python.mjs scripts/run_rag_eval.py",

    "test:quality:fast": "node scripts/run-python.mjs scripts/quality_gate.py --profile fast",
    "test:quality": "node scripts/run-python.mjs scripts/quality_gate.py --profile full",
    "test:quality:live": "node scripts/run-python.mjs scripts/quality_gate.py --profile full --include-live-ai",
